# WordPress core (track these only if you intentionally maintain a full WordPress fork)
/wp-admin/
/wp-includes/

# WordPress configuration and secrets
/wp-config.php
/.env
/.env.*
!/.env.example

# User uploads and generated media
/wp-content/uploads/

# Cache and temporary WordPress files
/wp-content/cache/
/wp-content/litespeed/
/wp-content/upgrade/
/wp-content/backup*/
/wp-content/wflogs/

# Logs
/debug.log
/error_log
*.log

# Local development/editor files
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary and backup files
*.tmp
*.bak
*.swp
*.old

# Database dumps and archives (remove these rules if you intentionally version sanitized fixtures)
/*.sql
/*.sql.gz
/*.zip
/*.tar
/*.tar.gz

# Dependencies, if applicable
/node_modules/
/vendor/
